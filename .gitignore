# ============================================================
# Classies Chronicles — repository hygiene
# ============================================================

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Python / Node / temporary tooling
__pycache__/
*.pyc
node_modules/
.npm/

# Environment / secrets
.env
.env.*
*.pem
*.key
secrets/
credentials/

# Temporary AI generation outputs
.tmp/
tmp/
working/
cache/
AI_TEMP/
AI_GENERATION_TEMP/

# Derived retrieval/index data — rebuildable
CC_AI_DESK/INDEX/
CC_AI_DESK/CACHE/
CC_AI_DESK/DERIVED/
*.sqlite-shm
*.sqlite-wal
*.faiss
*.npy

# Local harvested community data — NEVER commit raw personal/member data
CC_AI_DESK/COMMUNITY_HARVEST/
CC_AI_DESK/PRIVATE_MEMBER_DATA/

# Consent-sensitive exports
**/PRIVATE/
**/CONSENTED_RAW/
**/UNPUBLISHED_MEMBER_DATA/

# Audio/video scratch and renders
**/RAW_AUDIO/
**/RAW_VIDEO/
**/SCRATCH_AUDIO/
**/SCRATCH_VIDEO/
**/RENDERS/
*.wav
*.mp3
*.mp4
*.mov
*.mkv
*.avi

# Large project caches
*.peak
*.reapeaks
*.pek
*.cfa
*.ims

# Keep source documentation tracked
!**/*.md
!**/*.txt
!**/*.json
!**/*.yaml
!**/*.yml
!**/*.ps1
!**/*.js
!**/*.py

# Keep explicit production scripts/configuration tracked
!CC_AI_DESK/**/*.md
!CC_AI_DESK/**/*.txt
!CC_AI_DESK/**/*.json
!CC_S00_FOUNDATION_PHASE/**/*.md
!CC_S00_FOUNDATION_PHASE/**/*.txt
!CC_S00_FOUNDATION_PHASE/**/*.json

# Final approved media should be archived outside the source repository or via LFS.
