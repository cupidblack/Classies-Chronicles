# Secrets
.env
.env.*
*.key
*.pem
secrets/
credentials/
**/credentials/
**/*secret*

# Node / package caches
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.envrc

# AI Desk runtime / rebuildable indexes
CC_AI_DESK/**/runtime/
CC_AI_DESK/**/cache/
CC_AI_DESK/**/logs/
CC_AI_DESK/**/tmp/
CC_AI_DESK/**/indexes/
CC_AI_DESK/**/index/
CC_AI_DESK/**/fts/*.db
CC_AI_DESK/**/fts/*.sqlite
CC_AI_DESK/**/fts/*.sqlite3
CC_AI_DESK/**/embeddings/
CC_AI_DESK/**/vectorstore/
CC_AI_DESK/**/snapshots/runtime/

# Keep source configuration, prompts, Markdown, JSON and scripts tracked.

# Raw / generated media
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.png
*.jpg
*.jpeg
*.webp
*.gif

# Exception: small approved reference assets may be force-added if intentionally versioned.

# OBS / editing caches
OBS/
obs-cache/
recordings/
captures/
exports/
renders/
proxies/
cache/
*.peak
*.pek
*.cfa

# REAPER temporary/session artefacts
*.rpp-bak
*.reapeaks
REAPER_Backups/
REAPER_Temp/

# Video editor caches
CapCut/
Premiere Pro Auto-Save/
Adobe Premiere Pro Auto-Save/
DaVinci Resolve Cache/
*.prproj.bak

# OS/editor
Thumbs.db
.DS_Store
desktop.ini
.vscode/
.idea/

# Local databases not intended as canonical source
*.db
*.sqlite
*.sqlite3

# But keep explicitly versioned example schemas/templates
!**/examples/*.db
!**/examples/*.sqlite
!**/schemas/*.json

# Build output
dist/
build/
out/
coverage/

# Temporary archives
*.zip
*.7z
*.tar
*.gz
